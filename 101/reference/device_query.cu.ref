// 101/00 — Device Query
//
// Goal: before writing any kernels, find out exactly what hardware you're
// programming. The numbers this prints (SM count, warp size, max threads
// per block, shared memory per block, etc.) are the constraints every
// later kernel launch configuration is chosen around.
//
// Build:  make
// Run:    ./device_query

#include <cstdio>
#include "../../common/cuda_check.cuh"

int main() {
    int deviceCount = 0;
    CUDA_CHECK(cudaGetDeviceCount(&deviceCount));

    if (deviceCount == 0) {
        std::printf("No CUDA-capable device found.\n");
        return 1;
    }

    for (int dev = 0; dev < deviceCount; ++dev) {
        cudaDeviceProp prop{};
        CUDA_CHECK(cudaGetDeviceProperties(&prop, dev));

        std::printf("Device %d: %s\n", dev, prop.name);
        std::printf("  Compute capability:        %d.%d\n", prop.major, prop.minor);
        std::printf("  Total global memory:       %.2f GB\n",
                     prop.totalGlobalMem / (1024.0 * 1024.0 * 1024.0));
        std::printf("  Multiprocessor (SM) count: %d\n", prop.multiProcessorCount);
        std::printf("  Warp size:                 %d\n", prop.warpSize);
        std::printf("  Max threads per block:     %d\n", prop.maxThreadsPerBlock);
        std::printf("  Max threads per SM:        %d\n", prop.maxThreadsPerMultiProcessor);
        std::printf("  Max block dimensions:      [%d, %d, %d]\n",
                     prop.maxThreadsDim[0], prop.maxThreadsDim[1], prop.maxThreadsDim[2]);
        std::printf("  Max grid dimensions:       [%d, %d, %d]\n",
                     prop.maxGridSize[0], prop.maxGridSize[1], prop.maxGridSize[2]);
        std::printf("  Shared memory per block:   %zu KB\n", prop.sharedMemPerBlock / 1024);
        std::printf("  Shared memory per SM:      %zu KB\n", prop.sharedMemPerMultiprocessor / 1024);
        std::printf("  Registers per block:       %d\n", prop.regsPerBlock);
        std::printf("  Memory clock rate:         %.0f MHz\n", prop.memoryClockRate / 1000.0);
        std::printf("  Memory bus width:          %d-bit\n", prop.memoryBusWidth);
        std::printf("  Peak memory bandwidth:     %.1f GB/s\n",
                     2.0 * prop.memoryClockRate * (prop.memoryBusWidth / 8) / 1.0e6);
        std::printf("  Unified addressing:        %s\n", prop.unifiedAddressing ? "yes" : "no");
        std::printf("  Concurrent kernels:        %s\n", prop.concurrentKernels ? "yes" : "no");
        std::printf("  Async engine count:        %d (streams that can overlap copy/compute)\n",
                     prop.asyncEngineCount);
        std::printf("\n");
    }

    std::printf("Exercise: write down your SM count and max threads per block.\n");
    std::printf("In 202/303 you'll pick block sizes deliberately based on these numbers\n");
    std::printf("instead of guessing 256 every time.\n");

    return 0;
}
